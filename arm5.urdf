<?xml version="1.0"?>
<robot name="arm5">
  <material name="m_base"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="m_turret"><color rgba="0.2 0.4 0.8 1"/></material>
  <material name="m_upper_arm"><color rgba="0.95 0.5 0.1 1"/></material>
  <material name="m_forearm"><color rgba="0.2 0.7 0.3 1"/></material>
  <material name="m_hand"><color rgba="0.6 0.6 0.65 1"/></material>
  <material name="m_jaw_up"><color rgba="0.85 0.2 0.2 1"/></material>
  <material name="m_jaw_low"><color rgba="0.85 0.2 0.2 1"/></material>
  <link name="base">
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/base.stl" scale="1 1 1"/></geometry><material name="m_base"/></visual>
  </link>
  <link name="turret">
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/turret.stl" scale="1 1 1"/></geometry><material name="m_turret"/></visual>
  </link>
  <link name="upper_arm">
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/upper_arm.stl" scale="1 1 1"/></geometry><material name="m_upper_arm"/></visual>
  </link>
  <link name="forearm">
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/forearm.stl" scale="1 1 1"/></geometry><material name="m_forearm"/></visual>
  </link>
  <link name="hand">
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/hand.stl" scale="1 1 1"/></geometry><material name="m_hand"/></visual>
  </link>
  <link name="jaw_up">
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/jaw_up.stl" scale="1 1 1"/></geometry><material name="m_jaw_up"/></visual>
  </link>
  <link name="jaw_low">
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/jaw_low.stl" scale="1 1 1"/></geometry><material name="m_jaw_low"/></visual>
  </link>
  <joint name="j1_base" type="revolute">
    <parent link="base"/><child link="turret"/>
    <origin xyz="0.000000 -0.008825 0.048050"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="3"/>
  </joint>
  <joint name="j2_shoulder" type="revolute">
    <parent link="turret"/><child link="upper_arm"/>
    <origin xyz="0.000000 0.000826 0.040145"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="3"/>
  </joint>
  <joint name="j3_elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/>
    <origin xyz="0.000000 0.098789 0.081106"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="3"/>
  </joint>
  <joint name="j4_wrist" type="revolute">
    <parent link="forearm"/><child link="hand"/>
    <origin xyz="-0.002717 0.127290 -0.081118" rpy="-0.56737 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="1" velocity="3"/>
  </joint>
  <joint name="j5_jaw_up" type="revolute">
    <parent link="hand"/><child link="jaw_up"/>
    <origin xyz="0.000000 0.030915 0.017126"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="1" velocity="3"/>
  </joint>
  <joint name="j5_jaw_low" type="revolute">
    <parent link="hand"/><child link="jaw_low"/>
    <origin xyz="0.000000 0.030915 -0.014893"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="1" velocity="3"/>
  </joint>
</robot>
